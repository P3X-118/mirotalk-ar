
[Unit]
Description=Mirotalk ({{ mirotalk_identifier }})
{% for service in mirotalk_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in mirotalk_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
ExecStartPre=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} stop -t {{ sysd_docker_stop_grace }} {{ mirotalk_identifier }} 2>/dev/null || true'
ExecStartPre=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} rm {{ mirotalk_identifier }} 2>/dev/null || true'

ExecStartPre={{ sysd_docker_host_command }} create \
      --rm \
      --name={{ mirotalk_identifier }} \
      --log-driver=none \
      --user={{ mirotalk_uid }}:{{ mirotalk_gid }} \
      --network={{ mirotalk_container_network }} \
      {% if mirotalk_container_http_host_bind_port %}
      -p {{ mirotalk_container_http_host_bind_port }}:{{ mirotalk_container_http_port }} \
      {% endif %}
      --env-file={{ mirotalk_base_path }}/env  \
      --label-file={{ mirotalk_base_path }}/labels \
      {% for volume in mirotalk_container_additional_volumes %}
      --mount type={{ volume.type | default('bind' if '/' in volume.src else 'volume') }},src={{ volume.src }},dst={{ volume.dst }}{{ (',' + volume.options) if volume.options else '' }} \
      {% endfor %}
      {% for arg in mirotalk_container_extra_arguments %}
      {{ arg }} \
      {% endfor %}
      {{ mirotalk_container_image }}

{% for network in mirotalk_container_additional_networks %}
ExecStartPre={{ sysd_docker_host_command }} network connect {{ network }} {{ mirotalk_identifier }}
{% endfor %}

ExecStart={{ sysd_docker_host_command }} start --attach {{ mirotalk_identifier }}

ExecStop=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} stop -t {{ sysd_docker_stop_grace }} {{ mirotalk_identifier }} 2>/dev/null || true'
ExecStop=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} rm {{ mirotalk_identifier }} 2>/dev/null || true'

Restart=always
RestartSec=30
SyslogIdentifier={{ mirotalk_identifier }}

[Install]
WantedBy=multi-user.target
