{% if mirotalk_container_labels_traefik_enabled %}
traefik.enable=true

{% if mirotalk_container_labels_traefik_docker_network %}
traefik.docker.network={{ mirotalk_container_labels_traefik_docker_network }}
{% endif %}

{% set middlewares = [] %}

{% if mirotalk_container_labels_traefik_path_prefix != '/' %}
traefik.http.middlewares.{{ mirotalk_identifier }}-slashless-redirect.redirectregex.regex=^({{ mirotalk_container_labels_traefik_path_prefix | quote }})$
traefik.http.middlewares.{{ mirotalk_identifier }}-slashless-redirect.redirectregex.replacement=${1}/
{% set middlewares = middlewares + [mirotalk_identifier + '-slashless-redirect'] %}
{% endif %}

{% if mirotalk_container_labels_traefik_path_prefix != '/' %}
traefik.http.middlewares.{{ mirotalk_identifier }}-strip-prefix.stripprefix.prefixes={{ mirotalk_container_labels_traefik_path_prefix }}
{% set middlewares = middlewares + [mirotalk_identifier + '-strip-prefix'] %}
{% endif %}

{% if mirotalk_container_labels_traefik_additional_request_headers.keys() | length > 0 %}
{% for name, value in mirotalk_container_labels_traefik_additional_request_headers.items() %}
traefik.http.middlewares.{{ mirotalk_identifier }}-add-request-headers.headers.customrequestheaders.{{ name }}={{ value }}
{% endfor %}
{% set middlewares = middlewares + [mirotalk_identifier + '-add-request-headers'] %}
{% endif %}

{% if mirotalk_container_labels_traefik_additional_response_headers.keys() | length > 0 %}
{% for name, value in mirotalk_container_labels_traefik_additional_response_headers.items() %}
traefik.http.middlewares.{{ mirotalk_identifier }}-add-response-headers.headers.customresponseheaders.{{ name }}={{ value }}
{% endfor %}
{% set middlewares = middlewares + [mirotalk_identifier + '-add-response-headers'] %}
{% endif %}

traefik.http.routers.{{ mirotalk_identifier }}.rule={{ mirotalk_container_labels_traefik_rule }}
{% if mirotalk_container_labels_traefik_priority | int > 0 %}
traefik.http.routers.{{ mirotalk_identifier }}.priority={{ mirotalk_container_labels_traefik_priority }}
{% endif %}
traefik.http.routers.{{ mirotalk_identifier }}.service={{ mirotalk_identifier }}
{% if middlewares | length > 0 %}
traefik.http.routers.{{ mirotalk_identifier }}.middlewares={{ middlewares | join(',') }}
{% endif %}
traefik.http.routers.{{ mirotalk_identifier }}.entrypoints={{ mirotalk_container_labels_traefik_entrypoints }}
traefik.http.routers.{{ mirotalk_identifier }}.tls={{ mirotalk_container_labels_traefik_tls | to_json }}
{% if mirotalk_container_labels_traefik_tls %}
traefik.http.routers.{{ mirotalk_identifier }}.tls.certResolver={{ mirotalk_container_labels_traefik_tls_certResolver }}
{% endif %}

traefik.http.services.{{ mirotalk_identifier }}.loadbalancer.server.port={{ mirotalk_container_http_port }}
{% endif %}

{% for arg in mirotalk_container_labels_additional_labels %}
{{ arg }}
{% endfor %}
